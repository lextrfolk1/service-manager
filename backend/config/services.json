{
  "config": {
    "configServerUrl": "http://localhost:8888",
    "profiles": {
      "active": "dev"
    },
    "basePaths": {
      "java": "~/codebase/lextr",
      "python": "~/codebase/lextr",
      "npm": "~/codebase/lextr",
      "listener": "~/codebase/lextr",
      "default": "~/codebase/lextr"
    }
  },
  "services": {
    "frontend-service": {
      "type": "npm",
      "port": 3000,
      "path": "${basePaths.npm}/frontend-service",
      "command": "npm run dev",
      "description": "React Frontend Service"
    },
    "config-service": {
      "type": "java",
      "port": 8888,
      "path": "${basePaths.java}/config-service",
      "command": "mvn spring-boot:run",
      "build": "mvn clean install -DskipTests",
      "description": "Spring Cloud Config Server"
    },
    "auth-service": {
      "type": "java",
      "port": 8057,
      "path": "${basePaths.java}/auth-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Authentication and Authorization Service"
    },
    "generic-service": {
      "type": "java",
      "port": 8053,
      "path": "${basePaths.java}/generic-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "A generic service for common functionalities"
    },
    "workflow-service": {
      "type": "java",
      "port": 8051,
      "path": "${basePaths.java}/workflow-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Service to manage workflows"
    },
    "supplemental-service": {
      "type": "java",
      "port": 8082,
      "path": "${basePaths.java}/su-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Supplemental service for data uploads"
    },
    "workbench-service": {
      "type": "java",
      "port": 9090,
      "path": "${basePaths.java}/workbench-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Service to manage workbench operations"
    },
    "rules-service": {
      "type": "java",
      "port": 8054,
      "path": "${basePaths.java}/rules-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Service to manage business rules"
    },
    "reportgeneration-service": {
      "type": "java",
      "port": 8056,
      "path": "${basePaths.java}/reportgeneration-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "Service to handle report generation"
    },
    "gateway-service": {
      "type": "java",
      "port": 8080,
      "path": "${basePaths.java}/gateway-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "API Gateway Service"
    },
    "execution-service": {
      "type": "python",
      "port": 5002,
      "path": "${basePaths.python}/execution-service",
      "command": "$(pwd)/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 5002",
      "description": "Service to handle code execution tasks"
    },
    "execution-service-listener": {
      "type": "listener",
      "path": "${basePaths.listener}/execution-service",
      "command": "export PYTHONPATH=${basePaths.python}/execution-service && $(pwd)/venv/bin/python ${basePaths.python}/execution-service/utils/pg_sync_worker.py",
      "stopCommand": "pkill -f pg_sync_worker.py",
      "healthCommand": "pgrep -f pg_sync_worker.py > /dev/null",
      "description": "Execution Service listener"
    },
    "data-service": {
      "type": "python",
      "port": 5005,
      "path": "${basePaths.python}/data-service",
      "command": "$(pwd)/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 5005",
      "description": "Service to manage data operations"
    },
    "lexie-ai": {
      "type": "python",
      "port": 8004,
      "path": "${basePaths.python}/lexie-ai",
      "command": "$(pwd)/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8004",
      "description": "AI-powered assistant service"
    },
    "semantic-service": {
      "type": "java",
      "port": 8083,
      "path": "${basePaths.java}/semantic-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "description": "Semantic service",
      "group": "Data"
    },
    "analytics-service": {
      "type": "java",
      "port": 8055,
      "path": "${basePaths.java}/analytics-service",
      "command": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-Dspring.profiles.active=dev -Dspring.cloud.config.uri=http://localhost:8888\"",
      "build": "mvn clean install -DskipTests",
      "description": "analytical operation Service"
    },
    "intelligence-service": {
      "type": "java",
      "port": 8059,
      "path": "${basePaths.lextrai}/intelligence-service",
      "command": "mvn spring-boot:run",
      "build": "mvn clean install -DskipTests",
      "description": "Intelligence backend service"
    },
    "intelligence-ui": {
      "type": "npm",
      "port": 5173,
      "path": "${basePaths.lextrai}/intelligence-ui",
      "command": "npm run dev -- --host 0.0.0.0",
      "description": "Intelligence UI development server"
    },
    "redis": {
      "type": "redis",
      "port": 6379,
      "command": "redis-server",
      "stopCommand": "redis-cli shutdown",
      "description": "Redis in-memory data store"
    },
    "neo4j": {
      "type": "neo4j",
      "port": 7687,
      "command": "neo4j start",
      "stopCommand": "neo4j stop",
      "description": "Neo4j graph database",
      "group": "Database"
    },
    "postgresql": {
      "type": "database",
      "port": 5433,
      "daemon": true,
      "command": "brew services start postgresql@17",
      "stopCommand": "brew services stop postgresql@17",
      "healthCommand": "pg_isready -h localhost -p 5433",
      "description": "PostgreSQL 17 relational database",
      "group": "Database"
    },
    "neo4j-augmenta": {
      "type": "docker",
      "port": 7476,
      "daemon": true,
      "command": "docker start neo4j-augmenta 2>/dev/null || docker run -d --name neo4j-augmenta --restart unless-stopped -p 7476:7474 -p 7699:7687 -e NEO4J_AUTH=neo4j/Mygooru1028$ -e NEO4J_PLUGINS=[\\\"apoc\\\"] -e NEO4J_server_config_strict__validation_enabled=false -v neo4j-augmenta-data:/data neo4j:5",
      "stopCommand": "docker stop neo4j-augmenta",
      "healthCommand": "curl -sf http://localhost:7476/ > /dev/null",
      "description": "Neo4j Augmenta on Docker (Bolt: 7699)",
      "group": "Database"
    },
    "clickhouse": {
      "type": "docker",
      "port": 8123,
      "daemon": true,
      "command": "docker start clickhouse 2>/dev/null || docker run -d --name clickhouse --restart unless-stopped -p 8123:8123 -p 9000:9000 -e CLICKHOUSE_DB=default -e CLICKHOUSE_USER=default -e CLICKHOUSE_PASSWORD= -v clickhouse-data:/var/lib/clickhouse clickhouse/clickhouse-server:24.8",
      "stopCommand": "docker stop clickhouse",
      "healthCommand": "curl -sf http://localhost:8123/ping > /dev/null",
      "description": "ClickHouse analytics database on Docker (9000)"
    },
    "opa": {
      "type": "docker",
      "port": 8181,
      "daemon": true,
      "command": "docker start lextr-opa 2>/dev/null || docker run -d --name lextr-opa --restart unless-stopped -p 8181:8181 openpolicyagent/opa:1.4.2 run --server --addr 0.0.0.0:8181 --v0-compatible --log-level info",
      "stopCommand": "docker stop lextr-opa",
      "healthCommand": "curl -sf http://127.0.0.1:8181/health > /dev/null",
      "description": "Open Policy Agent on Docker"
    }
  }
}
